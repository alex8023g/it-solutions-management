# CockroachDB connection string. `sslmode=verify-full` expects the cluster CA
# cert at $HOME/.postgresql/root.crt — download it from the Cockroach Cloud
# console before the first connection.
DATABASE_URL="postgresql://user:password@host.cockroachlabs.cloud:26257/defaultdb?sslmode=verify-full"

# Port the NestJS server listens on.
PORT=3000
