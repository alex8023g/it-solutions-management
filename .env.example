# Copy to .env to override the defaults baked into docker-compose.yml.
# Every value below is optional — `docker compose up` works without this file.

# Connection string the backend and the migrate job use. The default targets
# the bundled single-node CockroachDB. Point it at Cockroach Cloud to run the
# API against the managed cluster (then `docker compose up backend frontend`).
DATABASE_URL=postgresql://root@db:26257/defaultdb?sslmode=disable

# Host ports. All four are published on 127.0.0.1 only, so they are reachable
# from the host (or an SSH tunnel) and never from the internet. On the server
# Caddy terminates TLS and reverse-proxies FRONTEND_PORT:
#
#   it-solutions-managment.grachev.dev {
#           reverse_proxy 127.0.0.1:3009
#   }
#
# Use 127.0.0.1 rather than localhost there: Docker binds IPv4 only, so a
# localhost that resolves to ::1 first yields a 502.
FRONTEND_PORT=8080
# Host side only — the container always listens on 3000 (see PORT in
# docker-compose.yml), which is what nginx's proxy_pass and the healthcheck
# target. 3000-3008 are taken on the deployed server, so the default sits
# above that range and is free to move again if it ever clashes.
BACKEND_PORT=3010
DB_PORT=26257
DB_CONSOLE_PORT=8081

# GraphQL endpoint compiled into the frontend bundle. Relative by default so
# nginx can proxy it to the backend container.
VITE_GRAPHQL_ENDPOINT=/graphql
