# Copy to .env to override the defaults baked into docker-compose.yml.
# Every value below is optional — `docker compose up` works without this file.

# Connection string the backend and the migrate job use. The default targets
# the bundled single-node CockroachDB. Point it at Cockroach Cloud to run the
# API against the managed cluster (then `docker compose up backend frontend`).
DATABASE_URL=postgresql://root@db:26257/defaultdb?sslmode=disable

# Host ports.
FRONTEND_PORT=8080
BACKEND_PORT=3000
DB_PORT=26257
DB_CONSOLE_PORT=8081

# GraphQL endpoint compiled into the frontend bundle. Relative by default so
# nginx can proxy it to the backend container.
VITE_GRAPHQL_ENDPOINT=/graphql
